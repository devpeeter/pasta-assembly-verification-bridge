def PastaBridge.MulMachine.Admissible : PastaBridge.MulMachine.Binding → Prop :=
fun binding => PastaBridge.KrakenBinding.Admissible PastaBridge.MulMachine.written binding
structure PastaBridge.MulCorrectness.InputContract (field : PastaCurves.PastaField)
  (binding : PastaBridge.MulCorrectness.Binding) (state : MachineData) : Prop
number of parameters: 3
fields:
  PastaBridge.MulCorrectness.InputContract.modulus_eq : PastaBridge.MulCorrectness.modulus binding state = field.modulus
  PastaBridge.MulCorrectness.InputContract.inv_eq : PastaBridge.MulCorrectness.inv binding state = field.inv
  PastaBridge.MulCorrectness.InputContract.operands : PastaCurves.mulContract
        (PastaBridge.MulCorrectness.lhs binding state) (PastaBridge.MulCorrectness.rhs binding state) field.modulus =
      true
constructor:
  PastaBridge.MulCorrectness.InputContract.mk {field : PastaCurves.PastaField}
    {binding : PastaBridge.MulCorrectness.Binding} {state : MachineData}
    (modulus_eq : PastaBridge.MulCorrectness.modulus binding state = field.modulus)
    (inv_eq : PastaBridge.MulCorrectness.inv binding state = field.inv)
    (operands :
      PastaCurves.mulContract (PastaBridge.MulCorrectness.lhs binding state)
          (PastaBridge.MulCorrectness.rhs binding state) field.modulus =
        true) :
    PastaBridge.MulCorrectness.InputContract field binding state
structure PastaBridge.MulCorrectness.Postcondition (field : PastaCurves.PastaField)
  (binding : PastaBridge.MulCorrectness.Binding) (before after : MachineData) : Prop
number of parameters: 4
fields:
  PastaBridge.MulCorrectness.Postcondition.model_eq : PastaBridge.MulCorrectness.output binding after =
      PastaCurves.AArch64.mulMont (PastaBridge.MulCorrectness.lhs binding before)
        (PastaBridge.MulCorrectness.rhs binding before) field.modulus field.inv
  PastaBridge.MulCorrectness.Postcondition.bounded : (PastaBridge.MulCorrectness.output binding after).Bounded
  PastaBridge.MulCorrectness.Postcondition.canonical : (PastaBridge.MulCorrectness.output binding after).toNat <
      field.modulus.toNat
  PastaBridge.MulCorrectness.Postcondition.congruent : 2 ^ 256 *
        (PastaBridge.MulCorrectness.output binding after).toNat ≡
      (PastaBridge.MulCorrectness.lhs binding before).toNat * (PastaBridge.MulCorrectness.rhs binding before).toNat [MOD
      field.modulus.toNat]
  PastaBridge.MulCorrectness.Postcondition.memory : after.dmem = before.dmem
  PastaBridge.MulCorrectness.Postcondition.stack : after.regs.SP = before.regs.SP
  PastaBridge.MulCorrectness.Postcondition.protected_registers : ∀ (queried : XReg),
      PastaBridge.MulCorrectness.Protected binding queried → after.regs.getXReg queried = before.regs.getXReg queried
  PastaBridge.MulCorrectness.Postcondition.readonly_registers : ∀ (queried : Fin 21),
      PastaBridge.MulStep.written queried = false →
        after.regs.getXReg (binding queried) = before.regs.getXReg (binding queried)
  PastaBridge.MulCorrectness.Postcondition.protected_x19 : PastaBridge.MulCorrectness.Protected binding XReg.X19 →
      after.regs.X19 = before.regs.X19
  PastaBridge.MulCorrectness.Postcondition.protected_x29 : after.regs.X29 = before.regs.X29
  PastaBridge.MulCorrectness.Postcondition.retained_bytes : String.ofList
        PastaBridge.retainedMultiplicationArtifactChars =
      PastaBridge.retainedMultiplicationCharonArtifact
  PastaBridge.MulCorrectness.Postcondition.retained_encoding : Except.map PastaBridge.StringBytes.bytes
        (PastaBridge.JsonEncoding.documentText 64 PastaBridge.retainedMultiplicationArtifactValue) =
      Except.ok PastaBridge.retainedMultiplicationArtifactBytes
  PastaBridge.MulCorrectness.Postcondition.retained_template : PastaBridge.MultiplicationArtifact.renderValue binding
        PastaBridge.retainedMultiplicationArtifactValue =
      PastaBridge.MultiplicationArtifact.serializeProgram (PastaBridge.MulMachine.boundProgram binding)
  PastaBridge.MulCorrectness.Postcondition.operand_metadata : PastaBridge.MultiplicationArtifact.operandModes
        PastaBridge.retainedMultiplicationArtifactValue =
      Except.ok (List.ofFn PastaBridge.MultiplicationArtifact.expectedOperandMode)
constructor:
  PastaBridge.MulCorrectness.Postcondition.mk {field : PastaCurves.PastaField}
    {binding : PastaBridge.MulCorrectness.Binding} {before after : MachineData}
    (model_eq :
      PastaBridge.MulCorrectness.output binding after =
        PastaCurves.AArch64.mulMont (PastaBridge.MulCorrectness.lhs binding before)
          (PastaBridge.MulCorrectness.rhs binding before) field.modulus field.inv)
    (bounded : (PastaBridge.MulCorrectness.output binding after).Bounded)
    (canonical : (PastaBridge.MulCorrectness.output binding after).toNat < field.modulus.toNat)
    (congruent :
      2 ^ 256 * (PastaBridge.MulCorrectness.output binding after).toNat ≡
        (PastaBridge.MulCorrectness.lhs binding before).toNat *
          (PastaBridge.MulCorrectness.rhs binding before).toNat [MOD
        field.modulus.toNat])
    (memory : after.dmem = before.dmem) (stack : after.regs.SP = before.regs.SP)
    (protected_registers :
      ∀ (queried : XReg),
        PastaBridge.MulCorrectness.Protected binding queried → after.regs.getXReg queried = before.regs.getXReg queried)
    (readonly_registers :
      ∀ (queried : Fin 21),
        PastaBridge.MulStep.written queried = false →
          after.regs.getXReg (binding queried) = before.regs.getXReg (binding queried))
    (protected_x19 : PastaBridge.MulCorrectness.Protected binding XReg.X19 → after.regs.X19 = before.regs.X19)
    (protected_x29 : after.regs.X29 = before.regs.X29)
    (retained_bytes :
      String.ofList PastaBridge.retainedMultiplicationArtifactChars = PastaBridge.retainedMultiplicationCharonArtifact)
    (retained_encoding :
      Except.map PastaBridge.StringBytes.bytes
          (PastaBridge.JsonEncoding.documentText 64 PastaBridge.retainedMultiplicationArtifactValue) =
        Except.ok PastaBridge.retainedMultiplicationArtifactBytes)
    (retained_template :
      PastaBridge.MultiplicationArtifact.renderValue binding PastaBridge.retainedMultiplicationArtifactValue =
        PastaBridge.MultiplicationArtifact.serializeProgram (PastaBridge.MulMachine.boundProgram binding))
    (operand_metadata :
      PastaBridge.MultiplicationArtifact.operandModes PastaBridge.retainedMultiplicationArtifactValue =
        Except.ok (List.ofFn PastaBridge.MultiplicationArtifact.expectedOperandMode)) :
    PastaBridge.MulCorrectness.Postcondition field binding before after
PastaBridge.MulCorrectness.multiplication_correct
  PastaCurves.pallasBase : ∀ (binding : PastaBridge.MulCorrectness.Binding) (state : MachineData),
  PastaBridge.MulMachine.Admissible binding →
    PastaBridge.MulCorrectness.InputContract PastaCurves.pallasBase binding state →
      ∃ after,
        PastaBridge.MulMachine.runWithBinding binding state = Except.ok after ∧
          PastaBridge.MulCorrectness.Postcondition PastaCurves.pallasBase binding state after
PastaBridge.MulCorrectness.multiplication_correct
  PastaCurves.vestaBase : ∀ (binding : PastaBridge.MulCorrectness.Binding) (state : MachineData),
  PastaBridge.MulMachine.Admissible binding →
    PastaBridge.MulCorrectness.InputContract PastaCurves.vestaBase binding state →
      ∃ after,
        PastaBridge.MulMachine.runWithBinding binding state = Except.ok after ∧
          PastaBridge.MulCorrectness.Postcondition PastaCurves.vestaBase binding state after
