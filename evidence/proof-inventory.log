'PastaAssemblyBridge.Arithmetic.addition' depends on axioms: [propext, Classical.choice, Quot.sound]
'PastaAssemblyBridge.Arithmetic.multiplication' depends on axioms: [propext, Classical.choice, Quot.sound]
PastaAssemblyBridge.Arithmetic.addition
  PastaCurves.pallasBase : ∀ (lhs rhs : PastaCurves.Limbs),
  lhs.Bounded →
    rhs.Bounded →
      lhs.toNat < PastaCurves.pallasBase.modulus.toNat →
        rhs.toNat < PastaCurves.pallasBase.modulus.toNat →
          have res := PastaCurves.AArch64.addMod lhs rhs PastaCurves.pallasBase.modulus;
          res.Bounded ∧
            res.toNat < PastaCurves.pallasBase.modulus.toNat ∧
              res.toNat ≡ lhs.toNat + rhs.toNat [MOD PastaCurves.pallasBase.modulus.toNat]
PastaAssemblyBridge.Arithmetic.addition
  PastaCurves.vestaBase : ∀ (lhs rhs : PastaCurves.Limbs),
  lhs.Bounded →
    rhs.Bounded →
      lhs.toNat < PastaCurves.vestaBase.modulus.toNat →
        rhs.toNat < PastaCurves.vestaBase.modulus.toNat →
          have res := PastaCurves.AArch64.addMod lhs rhs PastaCurves.vestaBase.modulus;
          res.Bounded ∧
            res.toNat < PastaCurves.vestaBase.modulus.toNat ∧
              res.toNat ≡ lhs.toNat + rhs.toNat [MOD PastaCurves.vestaBase.modulus.toNat]
PastaAssemblyBridge.Arithmetic.multiplication
  PastaCurves.pallasBase : ∀ (lhs rhs : PastaCurves.Limbs),
  lhs.Bounded →
    rhs.Bounded →
      PastaCurves.mulContract lhs rhs PastaCurves.pallasBase.modulus = true →
        have res := PastaCurves.AArch64.mulMont lhs rhs PastaCurves.pallasBase.modulus PastaCurves.pallasBase.inv;
        res.Bounded ∧
          res.toNat < PastaCurves.pallasBase.modulus.toNat ∧
            2 ^ 256 * res.toNat ≡ lhs.toNat * rhs.toNat [MOD PastaCurves.pallasBase.modulus.toNat]
PastaAssemblyBridge.Arithmetic.multiplication
  PastaCurves.vestaBase : ∀ (lhs rhs : PastaCurves.Limbs),
  lhs.Bounded →
    rhs.Bounded →
      PastaCurves.mulContract lhs rhs PastaCurves.vestaBase.modulus = true →
        have res := PastaCurves.AArch64.mulMont lhs rhs PastaCurves.vestaBase.modulus PastaCurves.vestaBase.inv;
        res.Bounded ∧
          res.toNat < PastaCurves.vestaBase.modulus.toNat ∧
            2 ^ 256 * res.toNat ≡ lhs.toNat * rhs.toNat [MOD PastaCurves.vestaBase.modulus.toNat]
