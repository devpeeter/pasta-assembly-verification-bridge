def PastaBridge.AdditionMachine.Admissible : PastaBridge.AdditionMachine.Binding → Prop :=
fun binding => PastaBridge.KrakenBinding.Admissible PastaBridge.AdditionMachine.written binding
structure PastaBridge.AdditionCorrectness.InputContract (field : PastaCurves.PastaField)
  (binding : PastaBridge.AdditionCorrectness.Binding) (state : MachineData) : Prop
number of parameters: 3
fields:
  PastaBridge.AdditionCorrectness.InputContract.modulus_eq : PastaBridge.AdditionCorrectness.modulus binding state =
      field.modulus
  PastaBridge.AdditionCorrectness.InputContract.lhs_lt : (PastaBridge.AdditionCorrectness.lhs binding state).toNat <
      field.modulus.toNat
  PastaBridge.AdditionCorrectness.InputContract.rhs_lt : (PastaBridge.AdditionCorrectness.rhs binding state).toNat <
      field.modulus.toNat
constructor:
  PastaBridge.AdditionCorrectness.InputContract.mk {field : PastaCurves.PastaField}
    {binding : PastaBridge.AdditionCorrectness.Binding} {state : MachineData}
    (modulus_eq : PastaBridge.AdditionCorrectness.modulus binding state = field.modulus)
    (lhs_lt : (PastaBridge.AdditionCorrectness.lhs binding state).toNat < field.modulus.toNat)
    (rhs_lt : (PastaBridge.AdditionCorrectness.rhs binding state).toNat < field.modulus.toNat) :
    PastaBridge.AdditionCorrectness.InputContract field binding state
def PastaBridge.AdditionCorrectness.Protected : PastaBridge.AdditionCorrectness.Binding → XReg → Prop :=
fun binding queried =>
  ∀ (destination : Fin 15), PastaBridge.AdditionStep.written destination = true → queried ≠ binding destination
structure PastaBridge.AdditionCorrectness.Postcondition (field : PastaCurves.PastaField)
  (binding : PastaBridge.AdditionCorrectness.Binding) (before after : MachineData) : Prop
number of parameters: 4
fields:
  PastaBridge.AdditionCorrectness.Postcondition.model_eq : PastaBridge.AdditionCorrectness.output binding after =
      PastaCurves.AArch64.addMod (PastaBridge.AdditionCorrectness.lhs binding before)
        (PastaBridge.AdditionCorrectness.rhs binding before) field.modulus
  PastaBridge.AdditionCorrectness.Postcondition.bounded : (PastaBridge.AdditionCorrectness.output binding after).Bounded
  PastaBridge.AdditionCorrectness.Postcondition.canonical : (PastaBridge.AdditionCorrectness.output binding
          after).toNat <
      field.modulus.toNat
  PastaBridge.AdditionCorrectness.Postcondition.congruent : (PastaBridge.AdditionCorrectness.output binding
          after).toNat ≡
      (PastaBridge.AdditionCorrectness.lhs binding before).toNat +
        (PastaBridge.AdditionCorrectness.rhs binding before).toNat [MOD
      field.modulus.toNat]
  PastaBridge.AdditionCorrectness.Postcondition.memory : after.dmem = before.dmem
  PastaBridge.AdditionCorrectness.Postcondition.stack : after.regs.SP = before.regs.SP
  PastaBridge.AdditionCorrectness.Postcondition.protected_registers : ∀ (queried : XReg),
      PastaBridge.AdditionCorrectness.Protected binding queried →
        after.regs.getXReg queried = before.regs.getXReg queried
  PastaBridge.AdditionCorrectness.Postcondition.readonly_registers : ∀ (queried : Fin 15),
      PastaBridge.AdditionStep.written queried = false →
        after.regs.getXReg (binding queried) = before.regs.getXReg (binding queried)
  PastaBridge.AdditionCorrectness.Postcondition.protected_x19 : PastaBridge.AdditionCorrectness.Protected binding
        XReg.X19 →
      after.regs.X19 = before.regs.X19
  PastaBridge.AdditionCorrectness.Postcondition.protected_x29 : after.regs.X29 = before.regs.X29
  PastaBridge.AdditionCorrectness.Postcondition.retained_template : PastaBridge.BindingArtifact.renderArtifactWithBinding
        binding PastaBridge.retainedCharonArtifact "add" =
      PastaBridge.serializeAdditionProgram (PastaBridge.AdditionMachine.boundProgram binding)
  PastaBridge.AdditionCorrectness.Postcondition.operand_metadata : PastaBridge.operandModesFromArtifact
        PastaBridge.retainedCharonArtifact "add" =
      Except.ok (List.ofFn PastaBridge.additionExpectedOperandMode)
constructor:
  PastaBridge.AdditionCorrectness.Postcondition.mk {field : PastaCurves.PastaField}
    {binding : PastaBridge.AdditionCorrectness.Binding} {before after : MachineData}
    (model_eq :
      PastaBridge.AdditionCorrectness.output binding after =
        PastaCurves.AArch64.addMod (PastaBridge.AdditionCorrectness.lhs binding before)
          (PastaBridge.AdditionCorrectness.rhs binding before) field.modulus)
    (bounded : (PastaBridge.AdditionCorrectness.output binding after).Bounded)
    (canonical : (PastaBridge.AdditionCorrectness.output binding after).toNat < field.modulus.toNat)
    (congruent :
      (PastaBridge.AdditionCorrectness.output binding after).toNat ≡
        (PastaBridge.AdditionCorrectness.lhs binding before).toNat +
          (PastaBridge.AdditionCorrectness.rhs binding before).toNat [MOD
        field.modulus.toNat])
    (memory : after.dmem = before.dmem) (stack : after.regs.SP = before.regs.SP)
    (protected_registers :
      ∀ (queried : XReg),
        PastaBridge.AdditionCorrectness.Protected binding queried →
          after.regs.getXReg queried = before.regs.getXReg queried)
    (readonly_registers :
      ∀ (queried : Fin 15),
        PastaBridge.AdditionStep.written queried = false →
          after.regs.getXReg (binding queried) = before.regs.getXReg (binding queried))
    (protected_x19 : PastaBridge.AdditionCorrectness.Protected binding XReg.X19 → after.regs.X19 = before.regs.X19)
    (protected_x29 : after.regs.X29 = before.regs.X29)
    (retained_template :
      PastaBridge.BindingArtifact.renderArtifactWithBinding binding PastaBridge.retainedCharonArtifact "add" =
        PastaBridge.serializeAdditionProgram (PastaBridge.AdditionMachine.boundProgram binding))
    (operand_metadata :
      PastaBridge.operandModesFromArtifact PastaBridge.retainedCharonArtifact "add" =
        Except.ok (List.ofFn PastaBridge.additionExpectedOperandMode)) :
    PastaBridge.AdditionCorrectness.Postcondition field binding before after
PastaBridge.AdditionCorrectness.addition_correct
  PastaCurves.pallasBase : ∀ (binding : PastaBridge.AdditionCorrectness.Binding) (state : MachineData),
  PastaBridge.AdditionMachine.Admissible binding →
    PastaBridge.AdditionCorrectness.InputContract PastaCurves.pallasBase binding state →
      ∃ after,
        PastaBridge.AdditionMachine.runWithBinding binding state = Except.ok after ∧
          PastaBridge.AdditionCorrectness.Postcondition PastaCurves.pallasBase binding state after
PastaBridge.AdditionCorrectness.addition_correct
  PastaCurves.vestaBase : ∀ (binding : PastaBridge.AdditionCorrectness.Binding) (state : MachineData),
  PastaBridge.AdditionMachine.Admissible binding →
    PastaBridge.AdditionCorrectness.InputContract PastaCurves.vestaBase binding state →
      ∃ after,
        PastaBridge.AdditionMachine.runWithBinding binding state = Except.ok after ∧
          PastaBridge.AdditionCorrectness.Postcondition PastaCurves.vestaBase binding state after
