'PastaBridge.MulCorrectness.lhs_bounded' depends on axioms: [propext, Quot.sound]
'PastaBridge.MulCorrectness.rhs_bounded' depends on axioms: [propext, Quot.sound]
'PastaBridge.MulCorrectness.execution_frames' depends on axioms: [propext, Classical.choice, Quot.sound]
'PastaBridge.MulCorrectness.multiplication_correct' depends on axioms: [propext, Classical.choice, Quot.sound]
multiplication_correct
  pallasBase : ∀ (binding : Binding) (state : MachineData),
  MulMachine.Admissible binding →
    InputContract pallasBase binding state →
      ∃ after, MulMachine.runWithBinding binding state = Except.ok after ∧ Postcondition pallasBase binding state after
multiplication_correct
  vestaBase : ∀ (binding : Binding) (state : MachineData),
  MulMachine.Admissible binding →
    InputContract vestaBase binding state →
      ∃ after, MulMachine.runWithBinding binding state = Except.ok after ∧ Postcondition vestaBase binding state after
